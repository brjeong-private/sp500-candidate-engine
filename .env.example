# Azure identity. Use Azure CLI locally and managed identity in Azure.
AZURE_SUBSCRIPTION_ID=<subscription-id>
AZURE_TENANT_ID=<tenant-id>
AZURE_CREDENTIAL_MODE=azure_cli

# Azure Database for PostgreSQL Flexible Server.
PGHOST=<server-name>.postgres.database.azure.com
PGPORT=5432
PGDATABASE=candidate_engine
PGUSER=<entra-user-or-managed-identity-name>
PGSSLMODE=require
PGCONNECT_TIMEOUT=30

# Collection controls.
COLLECTOR_MAX_CONCURRENCY=6
COLLECTOR_HTTP_TIMEOUT_SECONDS=30
COLLECTOR_MAX_ATTEMPTS=4
COLLECTOR_MIN_SUCCESS_RATIO=0.95
HTTP_USER_AGENT=sp500-candidate-engine/0.1 contact@example.com
RAW_DATA_DIR=data/raw
LOG_DIR=logs

# Analytics execution policy.
# Candidate generation is opt-in with an explicit --date or --with-candidates.
# Versioned model and selection settings live under config/analytics.
# Qlib/model/candidate artifacts are written below the ignored data/output directory.

# Target production data providers.
MARKET_DATA_PROVIDER=massive
CORPORATE_ACTION_PROVIDER=massive
NEWS_DATA_PROVIDER=massive
IDENTIFIER_DATA_PROVIDER=sec_edgar
EARNINGS_CALENDAR_PROVIDER=alpha_vantage
FUNDAMENTALS_DATA_PROVIDER=sec_edgar

# Provider keys. Keep real values only in the ignored .env file.
MASSIVE_API_KEY=<massive-api-key>
MASSIVE_BASE_URL=https://api.massive.com
MASSIVE_PLAN=stocks_basic
MASSIVE_REQUESTS_PER_MINUTE=5
MASSIVE_PRICE_TIMING=end_of_day
MASSIVE_PRICE_HISTORY_YEARS=2
MASSIVE_DIVIDEND_HISTORY_SCOPE=free_plan_limited
MASSIVE_NEWS_HISTORY_SCOPE=free_plan_limited
ALPHA_VANTAGE_API_KEY=<alpha-vantage-api-key>
ALPHA_VANTAGE_BASE_URL=https://www.alphavantage.co/query
ALPHA_VANTAGE_REQUESTS_PER_DAY=25
ALPHA_VANTAGE_EARNINGS_SCOPE=all_symbols

# SEC has no API key. JSON APIs and bulk ZIP are free, but facts need normalization.
SEC_EDGAR_JSON_API_ENABLED=true
SEC_EDGAR_BULK_ZIP_ENABLED=true
SEC_FINANCIAL_NORMALIZATION_REQUIRED=true

# Contract delivery values are finalized after provider onboarding.
SP_DJI_DELIVERY_MODE=<api-sftp-or-file>
SP_DJI_ENDPOINT=<contract-endpoint>
SP_DJI_USERNAME=<contract-username>
SP_DJI_SECRET=<contract-secret>

WSH_DELIVERY_MODE=<api-sftp-or-file>
WSH_ENDPOINT=<contract-endpoint>
WSH_USERNAME=<contract-username>
WSH_SECRET=<contract-secret>
